<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Photo Gallery</title>

  <style>
    :root {
      --gallery-bg: #e9e4dc;
      --frame-white: #ffffff;
      --text-dark: #292929;
      --caption-muted: #777;
      --shadow: 0 8px 20px rgba(0, 0, 0, 0.14);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: var(--gallery-bg);
      color: var(--text-dark);
      font-family: Arial, Helvetica, sans-serif;
    }

    .gallery-section {
      width: min(1180px, 92%);
      margin: 0 auto;
      padding: 48px 0;
    }

    .gallery-heading {
      margin-bottom: 28px;
      text-align: center;
    }

    .gallery-heading h1 {
      margin: 0 0 8px;
      font-size: clamp(2rem, 4vw, 3.2rem);
      letter-spacing: 0.04em;
    }

    .gallery-heading p {
      margin: 0;
      color: var(--caption-muted);
      font-size: 1rem;
    }

    .gallery-wall {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 26px;
    }

    .photo-card {
      margin: 0;
      padding: 12px 12px 16px;
      background: var(--frame-white);
      border: 1px solid #dedede;
      box-shadow: var(--shadow);
      transition: transform 180ms ease, box-shadow 180ms ease;
    }

    .photo-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 14px 28px rgba(0, 0, 0, 0.2);
    }

    .photo-card img {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      background: #ddd;
    }

    .photo-card figcaption {
      padding-top: 13px;
      text-align: center;
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.02em;
    }

    .photo-card small {
      display: block;
      margin-top: 5px;
      color: var(--caption-muted);
      font-size: 0.78rem;
      font-weight: normal;
    }

    @media (max-width: 800px) {
      .gallery-wall {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 520px) {
      .gallery-section {
        padding: 32px 0;
      }

      .gallery-wall {
        grid-template-columns: 1fr;
        gap: 20px;
      }
    }
  </style>
</head>

<body>
  <main class="gallery-section">
    <header class="gallery-heading">
      <h1>Gallery Wall</h1>
      <p>A small collection of memorable moments</p>
    </header>

    <section class="gallery-wall" aria-label="Photo gallery">
      <figure class="photo-card">
        <img
          src="https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=900&q=80"
          alt="Mountain landscape at sunset"
        />
        <figcaption>
          Golden Horizon
          <small>Mountain views</small>
        </figcaption>
      </figure>

      <figure class="photo-card">
        <img
          src="https://images.unsplash.com/photo-1493246507139-91e8fad9978e?auto=format&fit=crop&w=900&q=80"
          alt="Green forest with sunlight"
        />
        <figcaption>
          Into the Woods
          <small>Quiet morning</small>
        </figcaption>
      </figure>

      <figure class="photo-card">
        <img
          src="https://images.unsplash.com/photo-1511497584788-876760111969?auto=format&fit=crop&w=900&q=80"
          alt="Sunlight shining through trees"
        />
        <figcaption>
          Sunlit Trails
          <small>Nature walk</small>
        </figcaption>
      </figure>

      <figure class="photo-card">
        <img
          src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=900&q=80"
          alt="Ocean waves on a beach"
        />
        <figcaption>
          Open Water
          <small>Coastal escape</small>
        </figcaption>
      </figure>

      <figure class="photo-card">
        <img
          src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=900&q=80"
          alt="Cabin beside a calm lake"
        />
        <figcaption>
          Lakeside Stay
          <small>A peaceful retreat</small>
        </figcaption>
      </figure>

      <figure class="photo-card">
        <img
          src="https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=900&q=80"
          alt="Lake surrounded by mountains"
        />
        <figcaption>
          Still Waters
          <small>Weekend adventure</small>
        </figcaption>
      </figure>
    </section>
  </main>
</body>
</html>
